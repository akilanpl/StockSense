{
  "name": "stocksense",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "typecheck": "next typegen && tsc --noEmit",
    "start": "next start",
    "lint": "eslint",
    "db:seed": "tsx prisma/seed.ts",
    "verify:inventory": "tsx scripts/verify-inventory.ts",
    "verify:auth": "tsx scripts/verify-auth.ts",
    "db:migrate": "prisma migrate deploy",
    "test:e2e": "playwright test",
    "verify:integration": "tsx scripts/verify-integration.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "next": "^16.4.3",
    "nodemailer": "^10.2.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.4",
    "eslint": "^9",
    "eslint-config-next": "^16.4.3",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "^8.0.0"
    }
  }
}
